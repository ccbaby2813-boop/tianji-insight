# ============================================================
# 天机推演 后端环境变量示例
# 复制为 .env 后填入你自己的配置；切勿提交真实 .env
#   cp .env.example .env
# ============================================================

NODE_ENV=development
PORT=3003

# ---------------- 数据库（MySQL） ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tianji_tuiyan
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_IDLE_TIMEOUT=60000

# ---------------- Redis ----------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# ---------------- 鉴权 ----------------
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
PII_HASH_SALT=please-change-me

# ---------------- 管理后台 ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_FALLBACK_TOKEN=

# ---------------- 微信小程序 / App ----------------
WX_APPID=
WX_APPSECRET=
MINIAPP_APPID=
MINIAPP_APPSECRET=
WX_MSG_TOKEN=
WX_MSG_AES_KEY=

# 网页端（官网 H5 支付、登录）
WX_WEB_APPID=
WX_WEB_APPSECRET=

# ---------------- 微信支付（国内） ----------------
WXPAY_APPID=
WXPAY_APP_APPID=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY=
WXPAY_NOTIFY_URL=https://your-domain.example.com/tianji/api/payment/wx-notify
TEST_PAY_ENABLED=0

# ---------------- Google Play Billing（海外） ----------------
GOOGLE_PLAY_PACKAGE=com.your.package
GOOGLE_PLAY_CREDENTIALS_PATH=
GOOGLE_PLAY_CREDENTIALS_JSON=
GOOGLE_PLAY_API_BASE=https://androidpublisher.googleapis.com
# 1 = 跳过真实验签，仅本地联调使用；生产严禁开启
GOOGLE_PLAY_TEST_MODE=0

# ---------------- 短信 / 推送 ----------------
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
PUSH_DOMAIN=
PUSH_SDKAPPID=
PUSH_ADMIN_ID=
PUSH_ADMIN_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---------------- 大模型（深度解读） ----------------
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_VIP_MODEL=

# ---------------- 业务参数 ----------------
VIP_DECODE_DAILY_LIMIT=1
VIP_DECODE_OVERRIDES=
AD_DAILY_LIMIT=10
REVIEW_CODE=
REVIEW_PHONE=

# ---------------- 应用内购买（其他渠道） ----------------
XPAY_ENV=sandbox
XPAY_OFFER_ID=
XPAY_APP_KEY=
