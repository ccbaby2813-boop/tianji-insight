/* sub/match/match/index.wxss - 易缘匹配结果页 v3.0
 * Visual Thesis: 宣纸留白 · 双卦交辉 · 大波浪S曲线 · 诗意排版 · 分享欲优先
 * 改造要点：超大留白 / 诗集字号对比 / 朱砂印章 / 夸张S曲线连接 / 折叠长文
 */

/* ========================================
 * 根容器：宣纸暖白浅色主题
 * ======================================== */
.page-container,
.page-container.page-match {
  --bg-base: #FFF8F3;
  --bg-elevated: #FFFFFF;
  --bg-muted: rgba(139, 115, 85, 0.04);
  --text-primary: #3A2E1F;
  --text-secondary: #6B5A45;
  --text-muted: #9B8B75;
  --accent-gold: #C8A55B;
  --accent-gold-border: rgba(200, 165, 91, 0.3);
  --cinnabar: #A83E32;

  width: 100%;
  min-height: 100vh;
  background: var(--bg-base);
  overflow-x: hidden;
  color: var(--text-primary);
}

.match-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

/* ========================================
 * 主画布：宣纸留白，大量负空间
 * ======================================== */
.match-canvas {
  position: relative;
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 水墨晕染装饰角 */
.ink-wash {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  pointer-events: none;
  z-index: 0;
  opacity: 0.55;
}

.ink-wash-tl {
  top: -60rpx;
  left: -80rpx;
  background: radial-gradient(ellipse at 30% 30%,
    rgba(168, 62, 50, 0.08) 0%,
    rgba(139, 107, 74, 0.04) 35%,
    transparent 65%);
  transform: rotate(-18deg);
}

.ink-wash-br {
  bottom: 120rpx;
  right: -100rpx;
  background: radial-gradient(ellipse at 70% 70%,
    rgba(139, 107, 74, 0.08) 0%,
    rgba(200, 165, 91, 0.03) 40%,
    transparent 70%);
  transform: rotate(22deg);
}

/* 状态页 */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: var(--text-muted);
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.retry-btn {
  margin-top: 40rpx;
  width: 260rpx;
}

.bottom-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ========================================
 * 导语：诗意小字
 * ======================================== */
.match-preface {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-bottom: 56rpx;
}

.preface-line {
  display: block;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 30rpx;
  color: var(--cinnabar);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.preface-tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  word-break: break-word;
}

/* ========================================
 * 双卦交辉：大波浪 S 曲线连接
 * ======================================== */
.match-hero {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 48rpx;
  gap: 12rpx;
}

.gua-side {
  position: relative;
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 24rpx 8rpx;
}

.gua-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 165, 91, 0.16) 0%, transparent 65%);
  pointer-events: none;
  z-index: 0;
  animation: breathe 4s ease-in-out infinite;
}

.gua-side-a .gua-glow { animation-delay: 0s; }
.gua-side-b .gua-glow { animation-delay: 2s; }

.gua-symbol {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 88rpx;
  color: var(--accent-gold);
  line-height: 1.1;
  text-shadow: 0 0 32rpx rgba(200, 165, 91, 0.28);
}

.gua-name {
  position: relative;
  z-index: 1;
  display: block;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 32rpx;
  color: var(--text-primary);
  margin-top: 16rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.gua-ge {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
  word-break: break-word;
}

.nickname-chip {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: rgba(200, 165, 91, 0.08);
  border: 1rpx solid var(--accent-gold-border);
  border-radius: 28rpx;
}

.nickname-text {
  font-size: 22rpx;
  color: var(--accent-gold);
  letter-spacing: 1rpx;
}

.vip-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  padding: 0 6rpx;
  background: linear-gradient(135deg, #E8C896, var(--accent-gold));
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF5E8;
}

/* 大波浪 S 曲线连接 */
.connection-wave {
  position: relative;
  width: 132rpx;
  height: 280rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.wave-strand {
  position: absolute;
  width: 64rpx;
  height: 260rpx;
  pointer-events: none;
}

.wave-strand-1 {
  left: 14rpx;
  border-right: 2rpx solid rgba(200, 165, 91, 0.45);
  border-radius: 0 85% 0 85%;
  animation: waveSway 5s ease-in-out infinite;
}

.wave-strand-2 {
  right: 14rpx;
  border-left: 2rpx solid rgba(200, 165, 91, 0.28);
  border-radius: 85% 0 85% 0;
  animation: waveSway 6s ease-in-out infinite reverse;
}

@keyframes waveSway {
  0%, 100% { transform: translateY(0) scaleY(1); }
  50% { transform: translateY(-8rpx) scaleY(1.03); }
}

.wave-node {
  position: relative;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 248, 243, 0.9);
  border: 1rpx solid var(--accent-gold-border);
  border-radius: 50%;
  box-shadow: 0 0 20rpx rgba(200, 165, 91, 0.12);
}

/* 极细金线分隔 */
.line-gold-thin {
  position: relative;
  z-index: 2;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(200, 165, 91, 0.35) 20%,
    rgba(200, 165, 91, 0.35) 80%,
    transparent 100%);
  margin: 0 16rpx;
}

/* ========================================
 * 关系名称 + 一句话 + 匹配等级
 * ======================================== */
.relation-name {
  position: relative;
  z-index: 2;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--cinnabar);
  font-family: "STKaiti", "KaiTi", serif;
  letter-spacing: 16rpx;
  margin: 48rpx 0 16rpx;
  text-shadow: 0 2rpx 10rpx rgba(168, 62, 50, 0.12);
  line-height: 1.3;
}

.relation-oneliner {
  position: relative;
  z-index: 2;
  text-align: center;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 36rpx;
  font-style: italic;
}

.level-seal {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  max-width: 92%;
  margin: 0 auto 48rpx;
  padding: 20rpx 48rpx;
  background: rgba(200, 165, 91, 0.06);
  border: 1rpx solid var(--accent-gold-border);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.level-seal-text {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  color: var(--accent-gold);
  letter-spacing: 8rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.7;
  word-break: break-all;
}

.level-seal.level-tianzuo {
  box-shadow: 0 0 36rpx rgba(200, 165, 91, 0.18);
}

.level-seal.level-moqi {
  box-shadow: 0 0 24rpx rgba(200, 165, 91, 0.12);
}

.level-seal.level-hubu {
  box-shadow: 0 0 16rpx rgba(200, 165, 91, 0.08);
}

/* ========================================
 * 折叠区：无卡片，左金线
 * ======================================== */
.fold-section {
  position: relative;
  z-index: 2;
  margin: 0 0 32rpx;
  padding: 0 0 0 28rpx;
  border-left: 2rpx solid var(--accent-gold-border);
}

.fold-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.fold-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 26rpx;
  color: var(--accent-gold);
  letter-spacing: 6rpx;
  font-weight: 700;
}

.fold-arrow {
  transition: transform 0.3s var(--ease-out-expo);
}

.fold-arrow.expanded {
  transform: rotate(180deg);
}

.fold-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s var(--ease-out-expo);
}

.fold-body.expanded {
  max-height: 10000rpx;
}

.fold-text {
  display: block;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 2.0;
  letter-spacing: 1rpx;
  padding-bottom: 16rpx;
}

.fold-list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.fold-bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 16rpx;
}

.fold-bullet-gold {
  background: var(--accent-gold);
}

.fold-bullet-ink {
  background: var(--text-muted);
  opacity: 0.7;
}

/* ========================================
 * 底部双按钮
 * ======================================== */
.match-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 248, 243, 0.92);
  backdrop-filter: blur(20rpx);
  z-index: 1000;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(200, 165, 91, 0.18);
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: all 0.25s var(--ease-out-expo);
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.97);
}

.action-btn-text {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.action-btn-share {
  background: transparent;
  border: 1rpx solid var(--accent-gold);
  color: var(--accent-gold);
}

.action-btn-share:active {
  background: rgba(200, 165, 91, 0.08);
}

.action-btn-write {
  background: var(--accent-gold);
  color: #0A0A1A;
  box-shadow: 0 4rpx 16rpx rgba(200, 165, 91, 0.28);
}

.action-btn-write:active {
  background: #D4B570;
}

.action-btn-text-write {
  color: #0A0A1A;
  font-weight: 700;
}

/* ===== EN-i18n layout fix ===== */
.lang-en .action-btn { letter-spacing: 1rpx; text-indent: 1rpx; font-size: 26rpx; line-height: 1.3; }

/* ===== EN-i18n title fix ===== */
.lang-en .relation-name { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 40rpx; line-height: 1.25; }

/* ===== EN-i18n label fix ===== */
.lang-en .preface-line { letter-spacing: 2rpx; text-indent: 2rpx; line-height: 1.3; word-break: break-word; }
.lang-en .level-seal-text { letter-spacing: 2rpx; text-indent: 2rpx; line-height: 1.3; }
.lang-en .fold-title { letter-spacing: 1rpx; text-indent: 1rpx; line-height: 1.3; word-break: break-word; }

/* ===== EN-i18n 补充：昵称/卦名/一句话/折叠文本/空状态防出框 ===== */
.lang-en .relation-name { word-break: break-word; }
.lang-en .nickname-text { word-break: break-all; max-width: 100%; }
.lang-en .nickname-chip { max-width: 100%; }
.lang-en .gua-name { word-break: break-word; letter-spacing: 1rpx; font-size: 26rpx; }
.lang-en .gua-ge { word-break: break-word; font-size: 18rpx; }
.lang-en .preface-tip { word-break: break-word; line-height: 1.5; }
.lang-en .relation-oneliner { word-break: break-word; font-style: normal; line-height: 1.6; letter-spacing: 1rpx; }
.lang-en .fold-text { word-break: break-word; line-height: 1.7; letter-spacing: 0.5rpx; }
.lang-en .action-btn-text { word-break: keep-all; white-space: nowrap; font-size: 24rpx; }
.lang-en .empty-state { word-break: break-word; line-height: 1.5; padding: 0 32rpx; box-sizing: border-box; }
.lang-en .loading-state { word-break: break-word; }
