/* sub/match/letter-write/index.wxss - 易缘传书·写信：信纸纹理 + 四角金线 + 模板chip
 * Visual Thesis: 米白信纸承笔墨，四角金线勾勒仪式感，模板chip如灵感碎片飘落
 * 浅色主题：温暖浪漫，与匹配池/匹配结果风格统一
 */

/* ========================================
 * 根容器：启用浅色主题变量（温暖信纸氛围）
 * ======================================== */
.page-container {
  /* 浅色主题变量（覆盖 page 级深色变量） */
  --bg-base: #FFF8F3;
  --bg-elevated: #FFFFFF;
  --bg-warm: #FEF0E5;
  --bg-warmer: #FFFBF5;
  --bg-muted: rgba(200, 165, 91, 0.04);

  --text-primary: #3D2B1F;
  --text-secondary: #5B3A1F;
  --text-muted: #8B6B5A;
  --text-faint: #6B5A48;
  --text-inverse: #FFF8F3;

  --accent-gold: #C8A55B;
  --accent-gold-deep: #8B7340;
  --accent-gold-light: #C8A55B;
  --accent-gold-hover: #C8A55B;
  --accent-gold-muted: rgba(200, 165, 91, 0.08);
  --accent-gold-subtle: rgba(200, 165, 91, 0.04);
  --accent-gold-border: rgba(200, 165, 91, 0.25);

  --border-subtle: rgba(200, 165, 91, 0.08);
  --border-default: rgba(200, 165, 91, 0.15);
  --border-strong: rgba(200, 165, 91, 0.3);
  --border-paper: #F0E4D8;
  --border-paper-strong: #E8D5C4;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-full: 999rpx;

  --shadow-sm: 0 2rpx 8rpx rgba(200, 165, 91, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(200, 165, 91, 0.1);
  --shadow-lg: 0 16rpx 48rpx rgba(61, 43, 31, 0.25);
  --shadow-gold: 0 4rpx 16rpx rgba(200, 165, 91, 0.25);
  --shadow-gold-glow: 0 0 24rpx rgba(200, 165, 91, 0.2);

  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  width: 100%;
  min-height: 100vh;
  background: var(--bg-base);
  display: flex;
  flex-direction: column;
  color: var(--text-primary);
}

/* ========================================
 * 顶部导航栏
 * ======================================== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
  background: var(--bg-base);
  border-bottom: 1rpx solid var(--border-paper);
  flex-shrink: 0;
}

.nav-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s var(--ease-out-quart);
}

.nav-back-icon {
  font-size: 56rpx;
  color: var(--text-primary);
  line-height: 1;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
}

.nav-title-text {
  font-family: "Noto Serif SC", "STSong", serif;
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* VIP 金色 V 标识 */
.vip-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  border-radius: var(--radius-sm);
  background: var(--gold-pure);
  color: var(--text-inverse);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  vertical-align: middle;
  box-shadow:
    0 2rpx 6rpx rgba(200, 165, 91, 0.4),
    0 0 0 2rpx rgba(200, 165, 91, 0.15);
}

.nav-placeholder {
  width: 88rpx;
}

/* ========================================
 * 灵感模板栏：chip 如灵感碎片
 * ======================================== */
.template-section {
  flex-shrink: 0;
  padding: 16rpx 24rpx 12rpx;
  background: var(--bg-warm);
  border-bottom: 1rpx solid var(--border-paper);
}

.template-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.template-title {
  font-family: "Noto Serif SC", "STSong", serif;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  font-weight: 600;
}

.template-tip {
  font-size: 22rpx;
  color: var(--text-faint);
  letter-spacing: 1rpx;
  font-family: "STKaiti", "KaiTi", serif;
  word-break: break-word;
}

/* ========================================
 * v1.4 话题分组标签（聊人格/聊节气/聊推演/走心）
 * ======================================== */
.topic-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.topic-tabs-list {
  display: inline-flex;
  gap: 10rpx;
  padding: 4rpx 0;
}

.topic-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  background: transparent;
  border: 1rpx solid var(--border-paper-strong);
  border-radius: var(--radius-full);
  flex-shrink: 0;
  transition: all 0.2s var(--ease-out-quart);
  max-width: 200rpx;
  overflow: hidden;
}

.topic-tab-active {
  background: linear-gradient(135deg, var(--accent-gold-deep) 0%, var(--accent-gold-light) 100%);
  border-color: var(--accent-gold-deep);
  box-shadow: 0 4rpx 12rpx rgba(200, 165, 91, 0.3);
}

.topic-tab-emoji {
  font-size: 22rpx;
  line-height: 1;
  flex-shrink: 0;
}

.topic-tab-label {
  font-family: "Noto Serif SC", "STSong", serif;
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 140rpx;
}

.topic-tab-active .topic-tab-label {
  color: var(--text-inverse);
}

.template-bar {
  width: 100%;
  white-space: nowrap;
}

.template-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}

/* 模板 chip：默认白底描边 */
.template-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border-paper-strong);
  border-radius: var(--radius-full);
  flex-shrink: 0;
  transition: all 0.2s var(--ease-out-quart);
  max-width: 280rpx;
  overflow: hidden;
}

/* 模板 chip active：金色 tint */
.template-chip-active {
  background: linear-gradient(135deg, var(--accent-gold-deep) 0%, var(--accent-gold-light) 100%);
  border-color: var(--accent-gold-deep);
  box-shadow:
    0 4rpx 12rpx rgba(200, 165, 91, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.chip-emoji {
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.chip-label {
  font-family: "Noto Serif SC", "STSong", serif;
  font-size: 22rpx;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-chip-active .chip-label {
  color: var(--text-inverse);
}

/* ========================================
 * 信纸区域：古朴浪漫信纸（真正的信纸质感）
 * 设计理念：宣纸底色 + 横向格子线 + 双线装裱 + 四角金线 + 朱砂印章
 * 视觉特征：复古信笺纸 + 抬头双横线 + 落款分隔线
 * ======================================== */
.letter-scroll {
  flex: 1;
  height: 0;
}

.letter-paper {
  margin: 32rpx 32rpx 0;
  background: #F5EBD8;
  border-radius: var(--radius-sm);
  box-shadow:
    0 8rpx 32rpx rgba(61, 43, 31, 0.15),
    0 2rpx 8rpx rgba(61, 43, 31, 0.08);
  position: relative;
  animation: cardSlideIn 0.6s var(--ease-out-expo) both;
}

/* 装裱外层：双线边框模拟古卷装裱（外粗内细） */
.paper-mount-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 2rpx solid #8B6B4A;
  border-radius: var(--radius-sm);
  pointer-events: none;
  z-index: 4;
}

.paper-mount-border::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(139, 107, 74, 0.4);
  border-radius: 2rpx;
  pointer-events: none;
}

/* 四角金线装饰：L形细金线，模拟信纸角花 */
.paper-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  pointer-events: none;
  z-index: 3;
}

.paper-corner::before,
.paper-corner::after {
  content: '';
  position: absolute;
  background: linear-gradient(90deg, rgba(200, 165, 91, 0.6), rgba(200, 165, 91, 0.3));
}

.paper-corner::before {
  width: 48rpx;
  height: 1rpx;
}

.paper-corner::after {
  width: 1rpx;
  height: 48rpx;
}

.paper-corner-tl {
  top: 24rpx;
  left: 24rpx;
}

.paper-corner-tl::before { top: 0; left: 0; }
.paper-corner-tl::after { top: 0; left: 0; }

.paper-corner-tr {
  top: 24rpx;
  right: 24rpx;
}

.paper-corner-tr::before { top: 0; right: 0; }
.paper-corner-tr::after { top: 0; right: 0; }

.paper-corner-bl {
  bottom: 24rpx;
  left: 24rpx;
}

.paper-corner-bl::before { bottom: 0; left: 0; }
.paper-corner-bl::after { bottom: 0; left: 0; }

.paper-corner-br {
  bottom: 24rpx;
  right: 24rpx;
}

.paper-corner-br::before { bottom: 0; right: 0; }
.paper-corner-br::after { bottom: 0; right: 0; }

.letter-paper-inner {
  margin: 20rpx;
  border-radius: 2rpx;
  padding: 56rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
  min-height: 800rpx;
}

/* 信纸纹理层：横向格子线（真正的信纸质感）+ 淡墨晕染 */
.paper-texture {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    /* 横向格子线：每行56rpx，淡褐色，模拟信纸横纹 */
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 55rpx,
      rgba(139, 107, 74, 0.08) 55rpx,
      rgba(139, 107, 74, 0.08) 56rpx
    ),
    /* 淡墨晕染斑点 */
    radial-gradient(ellipse at 20% 15%, rgba(139, 107, 74, 0.05) 0%, transparent 30%),
    radial-gradient(ellipse at 80% 60%, rgba(139, 107, 74, 0.04) 0%, transparent 35%),
    radial-gradient(ellipse at 50% 85%, rgba(200, 165, 91, 0.03) 0%, transparent 30%);
  pointer-events: none;
  z-index: 0;
}

/* 朱砂印章装饰（已移除，保留样式兼容） */
.paper-seal,
.seal-square,
.seal-text {
  display: none;
}

@keyframes sealStampIn {
  0% { opacity: 0; transform: scale(1.8) rotate(-30deg); }
  60% { opacity: 1; transform: scale(0.9) rotate(0deg); }
  100% { opacity: 1; transform: scale(1) rotate(-6deg); }
}

/* 抬头双横线分隔（一粗一细，模拟信纸抬头） */
.paper-header-divider {
  position: relative;
  z-index: 1;
  margin: 8rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-line-thick {
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(139, 107, 74, 0.5) 10%,
    rgba(139, 107, 74, 0.7) 50%,
    rgba(139, 107, 74, 0.5) 90%,
    transparent 100%
  );
}

.header-line-thin {
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(139, 107, 74, 0.3) 10%,
    rgba(139, 107, 74, 0.4) 50%,
    rgba(139, 107, 74, 0.3) 90%,
    transparent 100%
  );
}

/* 落款分隔细金线 */
.paper-signoff-divider {
  position: relative;
  z-index: 1;
  height: 1rpx;
  margin: 24rpx 0 16rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(200, 165, 91, 0.4) 30%,
    rgba(200, 165, 91, 0.6) 70%,
    transparent 100%
  );
}

/* 竖排标题装饰（右侧"书笺"二字） */
.paper-vertical-title {
  position: absolute;
  top: 48rpx;
  left: 24rpx;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.35;
  pointer-events: none;
}

.vertical-char {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 44rpx;
  color: #C8A55B;
  font-weight: 600;
  letter-spacing: 0;
  writing-mode: vertical-rl;
  text-orientation: upright;
}

/* ========================================
 * 信纸内容：正文输入
 * ======================================== */
.letter-textarea {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 600rpx;
  font-family: "STKaiti", "KaiTi", "Noto Serif SC", "Georgia", serif;
  font-size: 32rpx;
  color: #C8A55B;
  line-height: 2;
  letter-spacing: 1rpx;
  background: transparent;
  text-align: justify;
  word-break: break-word;
  white-space: pre-wrap;
}

.letter-textarea-full {
  min-height: 800rpx;
  line-height: 1.8;
  letter-spacing: 0.8rpx;
}

.letter-placeholder {
  color: rgba(139, 107, 74, 0.5);
  font-family: "STKaiti", "KaiTi", "Georgia", serif;
  font-size: 32rpx;
  line-height: 2;
  letter-spacing: 1rpx;
}

/* 落款 */
.letter-signature {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  margin-top: 16rpx;
  padding-top: 12rpx;
  gap: 8rpx;
}

.signature-text {
  font-size: 22rpx;
  color: #C8A55B;
  letter-spacing: 2rpx;
  font-family: 'STSong', 'SimSun', 'KaiTi', serif;
  opacity: 0.7;
}

/* 字数统计 */
.letter-count {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(139, 107, 74, 0.3);
}

.count-text {
  font-size: 24rpx;
  color: #C8A55B;
  font-family: 'STKaiti', 'KaiTi', serif;
}

.count-warn {
  color: #C8423A !important;
}

/* v2.0 信封飞行动效 */
.envelope-fly {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
}

.envelope-fly.flying {
  animation: envelopeFly 1.5s var(--ease-out-expo) forwards;
}

.envelope-body {
  position: relative;
  width: 200rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #F5E6D3, #E8D4B8);
  border: 2rpx solid #C8A55B;
  border-radius: 4rpx;
  box-shadow: 0 8rpx 32rpx rgba(200, 165, 91, 0.4);
}

.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 100rpx solid transparent;
  border-right: 100rpx solid transparent;
  border-top: 70rpx solid #D4B896;
  transform-origin: top;
  animation: flapClose 0.6s var(--ease-out-expo) 0.2s both;
}

.envelope-front {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, transparent, rgba(200, 165, 91, 0.1));
}

@keyframes envelopeFly {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3) rotate(-10deg);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }
  60% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -300%) scale(0.5) rotate(15deg);
  }
}

@keyframes flapClose {
  0% { transform: rotateX(180deg); }
  100% { transform: rotateX(0deg); }
}

.letter-bottom-spacer {
  /* 撑高滚动区底部，给 fixed action-bar + tab-bar 留空间 */
  height: calc(260rpx + env(safe-area-inset-bottom));
}

/* ========================================
 * 底部操作栏：左小举报 + 右大寄信按钮（保持已存在布局）
 * ======================================== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  z-index: 1001;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: rgba(255, 248, 243, 0.95);
  border-top: 1rpx solid var(--border-paper);
  gap: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(61, 43, 31, 0.04);
  backdrop-filter: blur(20rpx);
}

.report-link {
  padding: 16rpx 8rpx;
  transition: opacity 0.2s var(--ease-out-quart);
}

.report-text {
  font-size: 24rpx;
  color: var(--text-faint);
  font-family: sans-serif;
}

/* 寄信按钮：艺术感性·极简文字 + 细下划线（去除金色按钮） */
.send-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: none;
  position: relative;
  overflow: visible;
  transition: all 0.3s var(--ease-out-expo);
}

.send-btn-line {
  width: 96rpx;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(200, 165, 91, 0.35) 20%,
    rgba(200, 165, 91, 0.85) 50%,
    rgba(200, 165, 91, 0.35) 80%,
    transparent 100%
  );
  transition: width 0.4s var(--ease-out-expo), opacity 0.3s var(--ease-out-expo);
}

.send-btn-disabled {
  opacity: 0.5;
}

.send-btn-text {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
  font-family: "STKaiti", "KaiTi", serif;
  position: relative;
  z-index: 1;
  text-shadow: none;
}

/* ========================================
 * 点击反馈态
 * ======================================== */
.nav-btn:active {
  opacity: 0.6;
}

.template-chip:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.report-link:active {
  opacity: 0.6;
}

.send-btn:not(.send-btn-disabled):active {
  opacity: 0.7;
}

.send-btn:not(.send-btn-disabled):active .send-btn-line {
  width: 160rpx;
  opacity: 1;
}

.send-btn:not(.send-btn-disabled):active .send-btn-text {
  letter-spacing: 16rpx;
  text-indent: 16rpx;
}

/* ===== EN-i18n label fix ===== */
.lang-en .send-btn-text { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 28rpx; line-height: 1.3; }
