/* sub/profile/notifications/index.wxss - 消息中心 */
.page-notifications {
  min-height: 100vh;
  background: #F4F3EE;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #F4F3EE;
  z-index: 100;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}
.navbar-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.navbar-title {
  flex: 1;
  text-align: center;
}
.navbar-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1B1C;
  letter-spacing: 2rpx;
}
.navbar-right {
  min-width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.navbar-action-text {
  font-size: 26rpx;
  color: #C8A55B;
  font-weight: 500;
}
.navbar-action-disabled {
  color: #CCC;
}

/* 内容区 */
.notifications-content {
  height: 100vh;
  box-sizing: border-box;
}

/* 通知列表 */
.notification-list {
  padding: 16rpx 24rpx;
}
.notification-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  background: #FFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.notification-item.is-unread {
  background: linear-gradient(135deg, #FFFEF7, #FFF);
  border-left: 6rpx solid #C8A55B;
}
.notification-item.is-read {
  opacity: 0.75;
}

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #EA6668;
}

/* 图标 */
.notification-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(200,165,91,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 内容 */
.notification-body {
  flex: 1;
  min-width: 0;
}
.notification-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1B1C;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}
.notification-time {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  white-space: nowrap;
}
.notification-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}
.load-more-text {
  font-size: 24rpx;
  color: #999;
}
.load-more-end {
  color: #CCC;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #999;
  margin-top: 32rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #BBB;
  margin-top: 12rpx;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #EEE 25%, #F5F5F5 50%, #EEE 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}
.skeleton-title {
  width: 40%;
  height: 40rpx;
  margin: 32rpx auto;
}
.skeleton-card {
  width: 90%;
  height: 120rpx;
  margin: 16rpx auto;
  border-radius: 16rpx;
}
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 英文适配 ===== */
.lang-en .navbar-title-text {
  font-size: 30rpx;
  letter-spacing: 1rpx;
}
.lang-en .notification-title {
  font-size: 26rpx;
  word-break: break-word;
}
.lang-en .notification-content {
  font-size: 24rpx;
  word-break: break-word;
}
.lang-en .navbar-action-text {
  font-size: 24rpx;
  word-break: break-word;
}
.lang-en .empty-title {
  font-size: 28rpx;
  word-break: break-word;
}
.lang-en .empty-desc {
  font-size: 24rpx;
  word-break: break-word;
  text-align: center;
  padding: 0 40rpx;
}
.lang-en .load-more-text {
  font-size: 22rpx;
  word-break: break-word;
}
