/* sub/profile/share/index.wxss - 分享选择页 */
.share-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.share-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.share-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.share-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 32rpx 0 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1B1C;
}

.share-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
}

.share-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx 16rpx 16rpx;
}

.share-channel {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  transition: opacity 0.15s;
}

.share-channel:active {
  opacity: 0.6;
}

.channel-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.channel-svg {
  display: block;
}

.channel-logo {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.channel-name {
  font-size: 24rpx;
  color: #555;
  text-align: center;
  line-height: 1.3;
  max-width: 140rpx;
  word-break: break-word;
}

.share-cancel {
  margin: 16rpx 32rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 16rpx;
}

.cancel-text {
  font-size: 30rpx;
  color: #666;
}

.share-cancel:active {
  background: #EBEBEB;
}
