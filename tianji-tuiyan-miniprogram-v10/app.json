    "backgroundColor": "#0A0E17",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#8B8BA0",
    "selectedColor": "#C8A96E",
    "backgroundColor": "#0A0E17",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "networkTimeout": {
    "request": 90000,
    "connectSocket": 60000,
    "uploadFile": 60000,
    "downloadFile": 60000
  },
  "permission": {},
  "__usePrivacyCheck__": true,
  "requiredPrivateInfos": [],
  "style": "v2",
  "sitemapLocation": "sitemap.json",
