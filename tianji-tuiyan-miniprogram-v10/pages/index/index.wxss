/* pages/index/index.wxss - 首页：水墨夜卷·天机秘境
 * Visual Thesis: 罗盘为视觉锚点（背景视频 + 金光呼吸光晕），输入区沉于底部，推演按钮金光流转
 * 融合 frontend-design（深邃氛围锚点）/ frontend-skill（克制构图 + 少而精动效）/ shadcn（语义化 token）
 */

/* ========================================
 * 页面容器
 * ======================================== */
.page-container {
  width: 100%;
  min-height: 100vh;
  background: var(--bg-base);
  position: relative;
  overflow: hidden;
}

/* ========================================
 * 自定义导航栏（毛玻璃 20rpx）
 * ======================================== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: 20rpx;
  background: linear-gradient(
    to bottom,
    rgba(10, 10, 26, 0.9) 0%,
    rgba(10, 10, 26, 0.6) 50%,
    rgba(10, 10, 26, 0) 100%
  );
  backdrop-filter: blur(20rpx);
}

.navbar-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeInUp 0.8s var(--ease-out-expo) both;
}

/* L2 标题字：导航栏标题 */
.navbar-title-text {
  font-family: 'LXGWWenKaiMedium', 'STXingkai', 'KaiTi', '楷体', 'Noto Serif CJK SC', serif;
  font-size: 44rpx;
  font-weight: 400;
  color: var(--accent-gold);
  letter-spacing: 12rpx;
  text-shadow:
    0 0 24rpx var(--accent-gold-border),
    0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.navbar-ornament {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  gap: 16rpx;
}

.ornament-line {
  width: 48rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--accent-gold-border), transparent);
}

.ornament-dot {
  font-size: 20rpx;
  color: var(--accent-gold);
}

/* ========================================
 * 顶部合规声明（上方明显处，导航栏下方）
 * ======================================== */
.disclaimer-banner {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 21;
  text-align: center;
  padding: 8rpx 64rpx;
  pointer-events: none;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 2rpx;
  line-height: 1.8;
  font-family: 'STSong', 'SimSun', 'KaiTi', serif;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
}

.lang-en .disclaimer-text {
  font-size: 20rpx;
  letter-spacing: 0;
}

/* ========================================
 * 背景视频 + 兜底海报（罗盘视觉锚点）
 * v15.3.4：image 海报作为底层兜底，video 叠加在上；video 加载失败时海报透出
 * v16.13：改用帧动画（image 组件），z-index 可控，按钮能正常显示
 * v16.15：双端分离 - 小程序端用远程视频（流畅），App 端用帧动画（z-index 可控）
 * ======================================== */
.bg-poster {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  object-fit: cover;
}

.bg-video {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  object-fit: cover;
}

/* 暗色遮罩 - 让罗盘更突出 */
.overlay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(10, 10, 26, 0.55) 0%,
    rgba(10, 10, 26, 0.25) 25%,
    rgba(10, 10, 26, 0.15) 45%,
    rgba(10, 10, 26, 0.35) 65%,
    rgba(10, 10, 26, 0.65) 85%,
    rgba(10, 10, 26, 0.85) 100%
  );
  z-index: 2;
}

/* 罗盘金光呼吸光晕：罗盘本身为背景视频，此处叠加呼吸式金色径向辉光 */
.overlay-mask::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    circle at 50% 42%,
    rgba(212, 165, 116, 0.18) 0%,
    rgba(212, 165, 116, 0.06) 26%,
    transparent 56%
  );
  animation: breathe 5s ease-in-out infinite;
  pointer-events: none;
}

/* ========================================
 * 主内容区（底部固定）
 * v4.8 同步下移60rpx，与玉璧保持间距
 * ======================================== */
.index-content {
  position: fixed;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  z-index: 10;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.2s both;
}

/* ========================================
 * 输入区（宽度71%，居中）
 * ======================================== */
.input-section {
  position: relative;
  width: 71%;
}

.question-input {
  width: 100%;
  height: 88rpx;
  background: rgba(10, 10, 26, 0.55);
  border: 2rpx solid var(--accent-gold-border);
  border-radius: var(--radius-full);
  padding: 0 32rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 88rpx;
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  transition: all 0.25s var(--ease-out-expo);
}

/* focus：border 变金 + 4rpx 金光晕 */
.question-input:focus {
  border-color: var(--accent-gold);
  background: rgba(10, 10, 26, 0.7);
  box-shadow:
    0 0 0 4rpx var(--accent-gold-muted),
    var(--shadow-lg);
}

.question-input::placeholder {
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.char-count {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--accent-gold-muted);
  pointer-events: none;
}

/* ========================================
 * 推演按钮（翻牌大钮，宽度62%，居中，比输入框窄约60rpx）
 * ======================================== */
.action-section {
  width: 62%;
  margin-top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* ========================================
 * 玉璧旋钮（独立机关，紧贴底部 tab 条中间）
 * v4.7 从 index-content 移出，独立 fixed 定位
 * ======================================== */
.jade-device-wrap {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
}

/* ========================================
 * 玉璧环扣机关
 * 结构：光晕 + 旋转容器 + 外环（含云纹+内环+中心+四象刻度）
 * 交互：点击后旋转180°，触发翻牌
 * ======================================== */
.jade-ring-device {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 光晕：normal态呼吸提示，vip态变暗 */
.jade-ring-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 110rpx;
  height: 110rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 165, 91, 0.22) 0%, transparent 65%);
  animation: jade-glow-pulse 3s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

.jade-ring-glow.dim {
  opacity: 0.3;
  animation: none;
}

@keyframes jade-glow-pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(0.85);
    opacity: 0.6;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.15);
    opacity: 1;
  }
}

/* 旋转容器：点击后旋转180° */
.jade-ring-wrap {
  width: 80rpx;
  height: 80rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.7s var(--ease-out-expo);
}

.jade-ring-wrap.rotated {
  transform: rotate(180deg);
}

/* 外环：金色圆环主体 */
.jade-ring-outer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 32%,
    #F4E0A0 0%,
    #E8C878 20%,
    #C8A55B 45%,
    #A88840 75%,
    #6A5520 100%);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.5),
    0 0 16rpx rgba(200, 165, 91, 0.35),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
}

/* 外圈云纹：用 conic-gradient 模拟古玉璧的谷纹/云纹 */
.jade-ring-pattern {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  background:
    repeating-conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 22deg,
      rgba(10, 10, 26, 0.25) 24deg,
      rgba(10, 10, 26, 0.25) 26deg,
      transparent 28deg,
      transparent 45deg
    );
  opacity: 0.7;
}

/* 内环：墨黑镂空区域 */
.jade-ring-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, #0A0A1A 0%, #1A1A2A 100%);
  border: 1rpx solid rgba(200, 165, 91, 0.5);
  box-shadow:
    inset 0 0 8rpx rgba(0, 0, 0, 0.8),
    inset 0 1rpx 2rpx rgba(200, 165, 91, 0.2);
}

/* 中心点：金色小圆（玉璧穿孔的"好"） */
.jade-ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: var(--gold-pure, #C8A55B);
  box-shadow:
    0 0 6rpx rgba(200, 165, 91, 0.9),
    inset 0 -1rpx 1rpx rgba(0, 0, 0, 0.3);
  z-index: 2;
}

/* 四象刻度：东南西北四个小金点（古玉璧的四象标记） */
.jade-mark {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #F4E0A0;
  box-shadow: 0 0 3rpx rgba(200, 165, 91, 0.8);
  z-index: 2;
}

.jade-mark-top {
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.jade-mark-bottom {
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.jade-mark-left {
  left: 2rpx;
  top: 50%;
  transform: translateY(-50%);
}

.jade-mark-right {
  right: 2rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 机关点击反馈 */
.jade-ring-device:active .jade-ring-outer {
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.5),
    0 0 24rpx rgba(200, 165, 91, 0.8),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.25);
}

/* ========================================
 * 翻牌大钮：居中显示
 * v4.5 宽度跟随 action-section（50%）
 * ======================================== */
.flip-panel {
  width: 100%;
  height: 88rpx;
  transition: transform 0.3s var(--ease-out-expo);
  transform: scaleX(1);
}

.flip-panel.flipping {
  transform: scaleX(0);
}

/* 面板共用样式 */
.panel-face {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.panel-title {
  font-size: 32rpx;
  letter-spacing: 10rpx;
  line-height: 1;
  position: relative;
  z-index: 2;
}

/* === 正面：易学解读（墨黑底 + 金边，日常感） === */
.panel-front {
  background: linear-gradient(135deg, #0A0A1A 0%, #1A1A2A 100%);
  color: var(--gold-pure, #C8A55B);
  border: 2rpx solid var(--gold-pure, #C8A55B);
  box-sizing: border-box;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.4),
    inset 0 1rpx 0 rgba(200, 165, 91, 0.15);
}

.panel-front::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(200,165,91,0.25), transparent);
  animation: panel-sweep 5s ease-in-out infinite;
  z-index: 1;
}

@keyframes panel-sweep {
  0% { left: -60%; }
  45%, 100% { left: 100%; }
}

.panel-front:active {
  transform: scale(0.97);
}

/* === 背面：深度解读（哑光拉丝金） === */
.panel-back {
  background: linear-gradient(160deg, #D4B87A 0%, #C8A55B 45%, #B8944A 100%);
  color: #2A1F0A;
  box-sizing: border-box;
  border: 1rpx solid rgba(200, 165, 91, 0.3);
  box-shadow:
    0 4rpx 16rpx rgba(180, 140, 60, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.panel-back:active {
  transform: scale(0.97);
  box-shadow:
    0 2rpx 8rpx rgba(180, 140, 60, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

/* 深度解读按钮内容容器：图标+标题+小字水平排列 */
.panel-back-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100%;
}

/* 剩余次数小字 */
.panel-sub-text {
  font-size: 22rpx;
  color: rgba(42, 31, 10, 0.72);
  letter-spacing: 1rpx;
  line-height: 1;
}

/* v17.0 正面（墨黑底）积分小字：竖向堆叠在标题下方 */
.panel-front-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 100%;
}

.panel-sub-text-front {
  color: rgba(200, 165, 91, 0.65);
  letter-spacing: 2rpx;
}

/* 深度解读三态（哑光拉丝金版） */
/* 状态1：可用 - 柔和呼吸光 */
.panel-back-available {
  animation: subtle-glow 4s ease-in-out infinite;
}

@keyframes subtle-glow {
  0%, 100% {
    box-shadow:
      0 4rpx 16rpx rgba(180, 140, 60, 0.25),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
  }
  50% {
    box-shadow:
      0 6rpx 24rpx rgba(200, 165, 91, 0.35),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  }
}

/* 状态2：已用完 - 哑光暗金 */
.panel-back-used {
  background: linear-gradient(160deg, #8A7B5A 0%, #6B5D42 100%);
  color: rgba(42, 31, 10, 0.4);
  border: 1rpx solid rgba(100, 80, 40, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 状态3：未开通VIP - 虚线边框 */
.panel-back-locked {
  background: linear-gradient(160deg, #D4B87A 0%, #B8944A 100%);
  border: 2rpx dashed rgba(42, 31, 10, 0.3);
  color: #2A1F0A;
  box-shadow: 0 4rpx 12rpx rgba(180, 140, 60, 0.2);
}

/* ========================================
 * 漂浮提示气泡（逐秒浮现，始终可见）
 * ======================================== */
.bubble-field {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 8;
  pointer-events: none;
}

.bubble-field .bubble {
  pointer-events: auto;
}

.bubble {
  position: absolute;
  padding: 16rpx 24rpx;
  background: rgba(18, 18, 42, 0.78);
  border: 1rpx solid rgba(200, 169, 110, 0.22);
  border-radius: 36rpx;
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(200, 169, 110, 0.12);
  animation: bubbleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both,
             bobFloat var(--float-dur, 2.8s) ease-in-out infinite;
  max-width: 320rpx;
}

.bubble text {
  font-size: 23rpx;
  color: rgba(212, 165, 116, 0.88);
  line-height: 1.45;
  text-align: center;
  display: block;
  word-break: break-word;
  overflow-wrap: break-word;
}

.bubble:active {
  background: rgba(200, 169, 110, 0.22);
  border-color: var(--accent-gold);
  box-shadow: 0 0 20rpx rgba(200, 169, 110, 0.3);
  transform: scale(1.03);
}

@keyframes bubbleIn {
  from { opacity: 0; transform: translateY(16rpx) scale(0.92); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes bobFloat {
  0%, 100% { transform: translateY(0); }
  30%      { transform: translateY(-10rpx); }
  60%      { transform: translateY(-4rpx); }
}

/* ========================================
 * 推演等待覆盖层
 * ======================================== */
.divine-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--bg-base);
}

/* --- 视频加载前的 spinner + 脉冲环 --- */
.wait-spinner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
  background: var(--bg-base);
}

.spinner-ring {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent-gold-muted);
  border-top-color: var(--accent-gold);
  border-right-color: var(--accent-gold-border);
  animation: spinner-rotate 1s linear infinite;
  box-shadow: var(--shadow-gold-glow);
}

/* 脉冲环 pulseRing：向外扩散并淡出 */
.spinner-ring::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 2rpx solid var(--accent-gold-border);
  animation: pulseRing 1.6s var(--ease-out-quart) infinite;
}

@keyframes spinner-rotate {
  to { transform: rotate(360deg); }
}

.spinner-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: var(--accent-gold);
  letter-spacing: 4rpx;
  opacity: 0.8;
}

/* --- 视频播完后的计算中等待页 --- */
.computing-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  background: var(--bg-base);
}

.computing-icon {
  font-size: 140rpx;
  color: var(--accent-gold);
  animation: computing-rotate 4s linear infinite;
  text-shadow: 0 0 40rpx var(--accent-gold-border);
}

@keyframes computing-rotate {
  to { transform: rotate(360deg); }
}

.computing-text-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
}

.computing-text {
  font-size: 32rpx;
  color: var(--accent-gold);
  font-weight: 500;
  letter-spacing: 4rpx;
}

.computing-dots {
  display: inline-flex;
  margin-left: 8rpx;
}

.computing-dots .cdot {
  font-size: 32rpx;
  color: var(--accent-gold);
  font-weight: 500;
  animation: dot-pulse 1.4s ease-in-out infinite;
}

.cdot.c1 { animation-delay: 0s; }
.cdot.c2 { animation-delay: 0.35s; }
.cdot.c3 { animation-delay: 0.7s; }

@keyframes dot-pulse {
  0%, 15% { opacity: 0; }
  35%, 85% { opacity: 1; }
  100% { opacity: 0; }
}

.computing-hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

/* ========================================
 * v4.1 VIP深度解读覆盖层（原secret页卦炉动画内嵌首页）
 * ======================================== */
.vip-divine-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 400;
  background: var(--bg-base);
}

/* --- 加载态：卦炉注入 --- */
.secret-loading {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
}

/* 中心光晕 */
.furnace-glow {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 400rpx;
  height: 400rpx;
  margin-left: -200rpx;
  margin-top: -200rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(200, 165, 91, 0.12) 0%,
    rgba(200, 165, 91, 0.04) 30%,
    transparent 60%);
  pointer-events: none;
  animation: glow-pulse 3s ease-in-out infinite;
}
@keyframes glow-pulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50%      { transform: scale(1.15); opacity: 1; }
}

/* 火焰粒子上升效果 */
.flame-particles {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 200rpx;
  height: 300rpx;
  margin-left: -100rpx;
  margin-top: -100rpx;
  pointer-events: none;
  z-index: 3;
}

.flame-particle {
  position: absolute;
  bottom: 0;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 165, 91, 0.9), rgba(200, 165, 91, 0.4), transparent);
  box-shadow: 0 0 8rpx rgba(200, 165, 91, 0.5);
  animation: flameRise 3s ease-out infinite;
}

.flame-particle.p1 { left: 20%; animation-delay: 0s; }
.flame-particle.p2 { left: 40%; animation-delay: 0.4s; }
.flame-particle.p3 { left: 55%; animation-delay: 0.8s; }
.flame-particle.p4 { left: 70%; animation-delay: 1.2s; }
.flame-particle.p5 { left: 30%; animation-delay: 1.6s; }
.flame-particle.p6 { left: 60%; animation-delay: 2.0s; }

@keyframes flameRise {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.5);
  }
  20% {
    opacity: 1;
    transform: translateY(-80rpx) scale(1);
  }
  60% {
    opacity: 0.6;
    transform: translateY(-180rpx) scale(1.2);
  }
  100% {
    opacity: 0;
    transform: translateY(-280rpx) scale(0.3);
  }
}

/* 变量飘入光晕拖尾 */
.var-item text {
  position: relative;
}
.var-item text::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -8rpx;
  width: 24rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 165, 91, 0.4), transparent);
  transform: translateY(-50%);
  opacity: 0.6;
  filter: blur(1rpx);
}

/* 卷轴展开动效 */
.scroll-unroll {
  animation: scrollUnroll 1.2s var(--ease-out-expo) both;
}

@keyframes scrollUnroll {
  0% {
    clip-path: inset(0 50% 0 50%);
    opacity: 0;
  }
  30% {
    clip-path: inset(0 50% 0 50%);
    opacity: 0.3;
  }
  100% {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }
}

/* 变量标签公共样式 */
.var-item {
  position: absolute;
  z-index: 2;
  pointer-events: none;
  animation-duration: 50s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-fill-mode: both;
}
.var-item text {
  font-size: 22rpx;
  color: rgba(200, 165, 91, 0.65);
  white-space: nowrap;
  text-shadow: 0 0 8rpx rgba(200, 165, 91, 0.15);
}

/* 8方向飘入动画 */
.var-drift-right { animation-name: drift-right; }
@keyframes drift-right {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(-60rpx, 0) scale(1); }
  10%      { opacity: 0.55; transform: translate(-140rpx, 0) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(-180rpx, 0) scale(0.9); }
  14%      { opacity: 0;    transform: translate(-195rpx, 0) scale(0.3); }
  100%     { opacity: 0;    transform: translate(-195rpx, 0) scale(0); }
}
.var-drift-bottomright { animation-name: drift-bottomright; }
@keyframes drift-bottomright {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(-45rpx, -40rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(-100rpx, -85rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(-130rpx, -110rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(-140rpx, -120rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(-140rpx, -120rpx) scale(0); }
}
.var-drift-bottom { animation-name: drift-bottom; }
@keyframes drift-bottom {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(0, -60rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(0, -140rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(0, -180rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(0, -195rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(0, -195rpx) scale(0); }
}
.var-drift-bottomleft { animation-name: drift-bottomleft; }
@keyframes drift-bottomleft {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(45rpx, -40rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(100rpx, -85rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(130rpx, -110rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(140rpx, -120rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(140rpx, -120rpx) scale(0); }
}
.var-drift-left { animation-name: drift-left; }
@keyframes drift-left {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(60rpx, 0) scale(1); }
  10%      { opacity: 0.55; transform: translate(140rpx, 0) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(180rpx, 0) scale(0.9); }
  14%      { opacity: 0;    transform: translate(195rpx, 0) scale(0.3); }
  100%     { opacity: 0;    transform: translate(195rpx, 0) scale(0); }
}
.var-drift-topleft { animation-name: drift-topleft; }
@keyframes drift-topleft {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(45rpx, 40rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(100rpx, 85rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(130rpx, 110rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(140rpx, 120rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(140rpx, 120rpx) scale(0); }
}
.var-drift-top { animation-name: drift-top; }
@keyframes drift-top {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(0, 60rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(0, 140rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(0, 180rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(0, 195rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(0, 195rpx) scale(0); }
}
.var-drift-topright { animation-name: drift-topright; }
@keyframes drift-topright {
  0%, 6%   { opacity: 0; transform: translate(0, 0) scale(0.7); }
  8%       { opacity: 0.55; transform: translate(-45rpx, 40rpx) scale(1); }
  10%      { opacity: 0.55; transform: translate(-100rpx, 85rpx) scale(0.95); }
  12%      { opacity: 0.3;  transform: translate(-130rpx, 110rpx) scale(0.9); }
  14%      { opacity: 0;    transform: translate(-140rpx, 120rpx) scale(0.3); }
  100%     { opacity: 0;    transform: translate(-140rpx, 120rpx) scale(0); }
}

/* 中心卦炉 — 光环旋转 + 卦字呼吸 */
.furnace-center {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 200rpx;
  height: 200rpx;
  margin-left: -100rpx;
  margin-top: -100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.furnace-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.ring-1 {
  width: 200rpx; height: 200rpx;
  border-top-color: rgba(200, 165, 91, 0.3);
  border-right-color: rgba(200, 165, 91, 0.15);
  animation: ring-rotate 8s linear infinite;
}
.ring-2 {
  width: 170rpx; height: 170rpx;
  border-bottom-color: rgba(200, 165, 91, 0.25);
  border-left-color: rgba(200, 165, 91, 0.1);
  animation: ring-rotate 6s linear infinite reverse;
}
.ring-3 {
  width: 140rpx; height: 140rpx;
  border-top-color: rgba(200, 165, 91, 0.2);
  border-right-color: rgba(200, 165, 91, 0.08);
  animation: ring-rotate 10s linear infinite;
}
@keyframes ring-rotate {
  to { transform: rotate(360deg); }
}

/* 卦字 — 中心金光晕 */
.furnace-char {
  font-size: 90rpx;
  font-weight: 900;
  color: var(--accent-gold);
  z-index: 1;
  text-shadow:
    0 0 20rpx rgba(200, 165, 91, 0.6),
    0 0 60rpx rgba(200, 165, 91, 0.3);
  box-shadow: var(--shadow-gold-glow);
  border-radius: 50%;
  animation: yi-breathe 2.2s ease-in-out infinite;
}
@keyframes yi-breathe {
  0%, 100% {
    opacity: 0.75;
    text-shadow: 0 0 20rpx rgba(200, 165, 91, 0.6), 0 0 60rpx rgba(200, 165, 91, 0.3);
  }
  50% {
    opacity: 1;
    text-shadow:
      0 0 30rpx rgba(200, 165, 91, 0.85),
      0 0 80rpx rgba(200, 165, 91, 0.45),
      0 0 120rpx rgba(200, 165, 91, 0.2);
  }
}

/* 底部文案 */
.loading-bottom {
  position: absolute;
  bottom: 18%;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 5;
}
.loading-text-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: var(--accent-gold);
  font-weight: 500;
}
.loading-dots {
  display: inline-flex;
  margin-left: 4rpx;
}
.loading-dots .dot {
  font-size: 28rpx;
  color: var(--accent-gold);
  font-weight: 500;
  animation: dot-blink 1.2s infinite;
}
.dot.d1 { animation-delay: 0s; }
.dot.d2 { animation-delay: 0.3s; }
.dot.d3 { animation-delay: 0.6s; }
@keyframes dot-blink {
  0%, 20%  { opacity: 0; }
  40%      { opacity: 1; }
  100%     { opacity: 1; }
}
.loading-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  display: block;
}

/* --- 结果态 --- */
.secret-result {
  height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 深度推演结果页 v3.0 样式 ========== */

/* 首屏仪式感标题区 */
.vip-hero {
  text-align: center;
  padding: 48rpx 0 32rpx;
  animation: fadeInUp 0.8s var(--ease-out-expo) both;
}

.vip-hero-title {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--accent-gold);
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 24rpx;
  text-shadow:
    0 0 40rpx rgba(200, 165, 91, 0.5),
    0 0 80rpx rgba(200, 165, 91, 0.25),
    0 0 120rpx rgba(200, 165, 91, 0.1);
}

.vip-hero-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vip-hero-line {
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--accent-gold-border), transparent);
}

.vip-user-info {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--gold-pure-dim);
  border-radius: 4rpx;
}

.vip-user-name {
  font-size: 26rpx;
  color: var(--accent-gold);
  font-weight: 500;
}

.vip-user-label {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

/* 问题展示（引用风格） */
.vip-question {
  text-align: center;
  padding: 32rpx 24rpx;
  margin: 0 16rpx;
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.08), rgba(200, 165, 91, 0.03));
  border-left: 6rpx solid var(--accent-gold);
  border-radius: 4rpx;
  position: relative;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.2s both;
}

.vip-question-mark {
  font-size: 32rpx;
  color: var(--accent-gold);
  opacity: 0.6;
  font-weight: 300;
}

.vip-question-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin: 0 12rpx;
  display: inline;
}

/* 金线分隔 */
.divider-gold {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
  margin: 32rpx auto;
  border-radius: 1rpx;
}

/* 折叠区容器 */
.vip-sections {
  margin: 0 8rpx;
}

/* 单个折叠段 */
.vip-section {
  margin-bottom: 8rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) both;
}

.vip-section:nth-child(1) { animation-delay: 0.1s; }
.vip-section:nth-child(2) { animation-delay: 0.15s; }
.vip-section:nth-child(3) { animation-delay: 0.2s; }
.vip-section:nth-child(4) { animation-delay: 0.25s; }
.vip-section:nth-child(5) { animation-delay: 0.3s; }
.vip-section:nth-child(6) { animation-delay: 0.35s; }

/* 折叠段头部 */
.vip-section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 20rpx;
  background: rgba(200, 165, 91, 0.04);
  border: 1rpx solid rgba(200, 165, 91, 0.15);
  border-radius: 6rpx;
  transition: all 0.3s var(--ease-out-expo);
}

.vip-section-header:active {
  background: rgba(200, 165, 91, 0.08);
  transform: scale(0.98);
}

/* 段落序号 — 中文数字金色圆点 */
.vip-section-number {
  font-size: 0;
  min-width: 56rpx;
  height: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.vip-section-number::before {
  font-size: 28rpx;
  color: #1A1A2A;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8C57A, #C8A55B);
  box-shadow: 0 2rpx 8rpx rgba(200, 165, 91, 0.4);
  font-family: 'STKaiti', 'KaiTi', '楷体', serif;
  letter-spacing: 0;
}

.vip-section:nth-child(1) .vip-section-number::before { content: '一'; }
.vip-section:nth-child(2) .vip-section-number::before { content: '二'; }
.vip-section:nth-child(3) .vip-section-number::before { content: '三'; }
.vip-section:nth-child(4) .vip-section-number::before { content: '四'; }
.vip-section:nth-child(5) .vip-section-number::before { content: '五'; }
.vip-section:nth-child(6) .vip-section-number::before { content: '六'; }

/* 段落标题 */
.vip-section-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 折叠箭头 */
.vip-section-arrow {
  transition: transform 0.3s var(--ease-out-expo);
  opacity: 0.6;
}

.vip-section-arrow.expanded {
  transform: rotate(180deg);
}

/* 折叠段内容 */
.vip-section-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s var(--ease-out-expo);
}

.vip-section-body.expanded {
  max-height: 2000rpx;
}

.vip-section-inner {
  padding: 24rpx 20rpx 32rpx;
  border-left: 2rpx solid rgba(200, 165, 91, 0.2);
  margin-left: 20rpx;
}

.vip-section-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 2.2;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  letter-spacing: 2rpx;
}

/* 底部合规声明 */
.vip-footer {
  text-align: center;
  padding: 40rpx 32rpx 24rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(200, 165, 91, 0.1);
}

.vip-footer-text {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  opacity: 0.7;
}

/* 底部操作栏 */
.vip-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0 32rpx;
}

.vip-action-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.25s var(--ease-out-expo);
  margin: 0;
  padding: 0;
  letter-spacing: 2rpx;
}

.vip-action-btn:active {
  transform: scale(0.97);
}

/* 分享按钮 - 金色渐变背景 */
.vip-action-share {
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.12), rgba(200, 165, 91, 0.04));
  border: 2rpx solid var(--accent-gold-border);
  color: var(--accent-gold);
}

.vip-action-share:active {
  background: var(--accent-gold-subtle);
}

/* 返回按钮 - 深色实心 */
.vip-action-back {
  background: var(--bg-muted);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-subtle);
}

.vip-action-back:active {
  background: rgba(232, 232, 240, 0.08);
}

/* ===== EN-i18n layout fix ===== */
.lang-en .vip-action-btn { letter-spacing: 1rpx; text-indent: 1rpx; font-size: 26rpx; line-height: 1.3; }

/* ===== EN-i18n title fix ===== */
.lang-en .navbar-title-text { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 30rpx; line-height: 1.25; }
.lang-en .vip-hero-title { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 44rpx; line-height: 1.25; }

/* ===== EN-i18n label fix ===== */
.lang-en .panel-title { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 28rpx; line-height: 1.3; }
