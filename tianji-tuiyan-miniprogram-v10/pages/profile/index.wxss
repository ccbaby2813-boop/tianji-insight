/* pages/profile/index.wxss - 建档页 v2.2
 * 三端统一：与修改档案页/我的页同款黑金极简风格
 * Visual Thesis: 黑底留白 + 1rpx 金线分隔 + 字号对比 + 零装饰
 */

.page-container {
  width: 100%;
  min-height: 100vh;
  background: var(--bg-ink);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.profile-content {
  height: 100vh;
  padding: 0 64rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  box-sizing: border-box;
}

/* ========================================
 * 顶部标题区：左对齐 + 细金线 + 合规提示
 * ======================================== */
.page-header {
  margin-bottom: 96rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) both;
}

.page-title {
  display: block;
  font-size: 56rpx;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  text-indent: 12rpx;
  font-weight: 400;
  line-height: 1.2;
}

.title-underline {
  width: 48rpx;
  height: 1rpx;
  background: var(--gold-pure);
  margin: 28rpx 0 24rpx;
  box-shadow: 0 0 8rpx rgba(200, 165, 91, 0.4);
}

.page-subtitle {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  line-height: 1.9;
  white-space: pre-line;
  opacity: 0.7;
}

/* ========================================
 * 表单列表：菜单式行（透明底 + 细金线分隔）
 * ======================================== */
.form-list {
  display: flex;
  flex-direction: column;
}

.form-item {
  padding: 40rpx 0;
  border-bottom: 1rpx solid rgba(200, 165, 91, 0.25);
  animation: fadeInUp 0.6s var(--ease-out-expo) both;
}

.form-item:nth-child(1) { animation-delay: 0.08s; }
.form-item:nth-child(2) { animation-delay: 0.16s; }
.form-item:nth-child(3) { animation-delay: 0.24s; }
.form-item:nth-child(4) { animation-delay: 0.32s; }
.form-item:nth-child(5) { animation-delay: 0.40s; }

.form-item:last-of-type {
  border-bottom: none;
}

/* 表单项头部：label + 右侧计数/提示 */
.form-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  font-weight: 400;
}

.form-counter,
.form-hint-inline {
  font-size: 22rpx;
  color: var(--text-faint);
  letter-spacing: 2rpx;
  opacity: 0.75;
  word-break: break-word;
}

/* 输入框：诗集式下划线 */
.form-input {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(200, 165, 91, 0.18);
  padding: 0 4rpx;
  color: var(--text-primary);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  box-sizing: border-box;
  transition: all 0.3s var(--ease-out-expo);
  font-family: 'LXGW WenKai', serif;
}

.form-input:focus {
  border-bottom-color: var(--gold-pure);
  box-shadow: 0 4rpx 12rpx -8rpx rgba(200, 165, 91, 0.4);
}

.form-placeholder {
  color: var(--text-faint);
  font-size: 28rpx;
  letter-spacing: 2rpx;
  opacity: 0.6;
}

/* 日期/时辰选择器 */
.picker-display {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(200, 165, 91, 0.18);
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-primary);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  box-sizing: border-box;
  transition: all 0.3s var(--ease-out-expo);
}

.picker-display:active {
  border-bottom-color: var(--gold-pure);
}

.picker-display.placeholder .picker-text {
  color: var(--text-faint);
  font-size: 28rpx;
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.picker-text {
  flex: 1;
  color: var(--text-primary);
  font-family: 'LXGW WenKai', serif;
}

.picker-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}

/* ========================================
 * 性别选择：极简金线方框
 * ======================================== */
.gender-group {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1rpx solid rgba(200, 165, 91, 0.20);
  transition: all 0.3s var(--ease-out-expo);
}

.gender-option:active {
  transform: scale(0.98);
}

.gender-text {
  font-size: 32rpx;
  color: var(--text-muted);
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  font-weight: 400;
  transition: all 0.3s var(--ease-out-expo);
}

.gender-option.active {
  border-color: var(--gold-pure);
  background: rgba(200, 165, 91, 0.06);
}

.gender-option.active .gender-text {
  color: var(--gold-pure);
  text-shadow: 0 0 12rpx rgba(200, 165, 91, 0.3);
}

/* ========================================
 * 协议勾选区
 * ======================================== */
.agreement-item {
  margin-top: 24rpx;
}

.agreement-label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 2.0;
  letter-spacing: 1rpx;
}

.agreement-label checkbox {
  margin-right: 12rpx;
  transform: scale(0.9);
}

.agreement-text {
  color: var(--text-muted);
}

.agreement-link {
  color: var(--gold-pure);
  text-decoration: underline;
  transition: color 0.2s var(--ease-out-quart);
}

.agreement-link:active {
  color: var(--accent-gold-hover);
}

/* ========================================
 * 提交区：极简金线按钮
 * ======================================== */
.form-submit-area {
  margin-top: 80rpx;
  padding-bottom: 48rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.4s both;
}

.submit-btn {
  width: 100%;
  height: 104rpx;
  background: transparent;
  border: 1rpx solid var(--gold-pure);
  border-radius: 0;
  color: var(--gold-pure);
  font-size: 30rpx;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
  font-weight: 400;
  transition: all 0.3s var(--ease-out-expo);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 提交按钮光泽扫过 */
.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(200, 165, 91, 0.15), transparent);
  transition: left 0.8s var(--ease-out-expo);
}

.submit-btn[disabled] {
  border-color: rgba(200, 165, 91, 0.15);
  color: rgba(232, 232, 240, 0.25);
}

.submit-btn[disabled]::before {
  display: none;
}

.submit-btn:not([disabled]):active {
  background: rgba(200, 165, 91, 0.08);
  transform: scale(0.99);
}

.submit-btn:not([disabled]):active::before {
  left: 100%;
}

.submit-text {
  position: relative;
  z-index: 1;
}

.submit-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

/* ========================================
 * 游客登录入口按钮
 * ======================================== */
.login-entry-wrap {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.login-entry-btn {
  width: 80%;
  height: 88rpx;
  background: transparent;
  border: 1rpx solid rgba(200, 165, 91, 0.45);
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s var(--ease-out-expo);
}

.login-entry-btn:active {
  background: rgba(200, 165, 91, 0.06);
  border-color: var(--gold-pure);
  transform: scale(0.99);
}

.login-entry-text {
  font-size: 26rpx;
  color: rgba(200, 165, 91, 0.7);
  letter-spacing: 4rpx;
  text-indent: 4rpx;
  font-weight: 400;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== EN-i18n layout fix ===== */
.lang-en .submit-btn {
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 2rpx; text-indent: 2rpx; font-size: 28rpx;
  line-height: 1.3; height: auto; min-height: 104rpx;
  padding: 0 24rpx; box-sizing: border-box; white-space: normal;
}

/* ===== EN-i18n title fix ===== */
.lang-en .page-title { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 36rpx; line-height: 1.25; }

/* ===== EN-i18n label fix ===== */
.lang-en .form-label { letter-spacing: 1rpx; text-indent: 1rpx; line-height: 1.3; }
.lang-en .gender-text { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 28rpx; line-height: 1.3; }
