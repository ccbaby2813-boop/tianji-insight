/* pages/result/index.wxss - 推演结果页 v3.0
 * 视觉重构：仪式感首屏 + 核心可见 + 情绪峰值分享 + 折叠详读
 */

/* ========================================
 * 页面容器
 * ======================================== */
.page-container {
  width: 100%;
  min-height: 100vh;
  background: var(--bg-base);
  position: relative;
  overflow-x: hidden;
}

.page-result {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.result-content {
  height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ========================================
 * 状态区
 * ======================================== */
.loading-state,
.error-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 80rpx 32rpx;
}

.loading-state { color: var(--text-muted); font-size: 28rpx; }
.error-state text,
.empty-state text { color: var(--text-muted); font-size: 28rpx; margin-bottom: 32rpx; }

.retry-btn { min-width: 200rpx; margin-top: 24rpx; }

/* ========================================
 * 分享查看提示
 * ======================================== */
.shared-notice {
  background: linear-gradient(90deg, transparent, rgba(200, 165, 91, 0.06), transparent);
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--accent-gold);
  letter-spacing: 1rpx;
  opacity: 0.8;
}

/* ========================================
 * 首屏仪式感区域
 * ======================================== */
.hero-section {
  text-align: center;
  padding: 80rpx 32rpx 48rpx;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.8s var(--ease-out-expo) both;
}

/* 首屏径向光晕背景 */
.hero-section::before {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  width: 600rpx; height: 600rpx;
  margin-left: -300rpx;
  background: radial-gradient(circle, rgba(200, 165, 91, 0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.hero-title,
.hero-symbol,
.hero-gua-info { position: relative; z-index: 1; }

.hero-title {
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--accent-gold-border);
  animation: fadeInUp 0.6s var(--ease-out-expo) both;
}

.hero-title-text {
  font-size: 26rpx;
  color: var(--accent-gold);
  letter-spacing: 6rpx;
  font-weight: 300;
  word-break: break-word;
  opacity: 0.6;
}

/* 卦符（超大，视觉锚点） */
.hero-symbol {
  font-size: 220rpx;
  line-height: 1;
  color: var(--gold-pure);
  display: block;
  margin: 24rpx 0;
  text-shadow:
    0 0 40rpx rgba(200, 165, 91, 0.5),
    0 0 80rpx rgba(200, 165, 91, 0.25),
    0 0 120rpx rgba(200, 165, 91, 0.1);
  animation: goldReveal 1.2s var(--ease-out-expo) 0.2s both;
}

/* 五行配色光晕 — 增强版 */
.aura-jin .hero-symbol { text-shadow: 0 0 40rpx rgba(200, 165, 91, 0.7), 0 0 80rpx rgba(200, 165, 91, 0.35), 0 0 120rpx rgba(200, 165, 91, 0.15); }
.aura-mu .hero-symbol { text-shadow: 0 0 40rpx rgba(200, 165, 91, 0.5), 0 0 80rpx rgba(200, 165, 91, 0.25), 0 0 120rpx rgba(200, 165, 91, 0.1); }
.aura-shui .hero-symbol { text-shadow: 0 0 40rpx rgba(200, 165, 91, 0.35), 0 0 80rpx rgba(200, 165, 91, 0.18), 0 0 120rpx rgba(200, 165, 91, 0.08); }
.aura-huo .hero-symbol { text-shadow: 0 0 40rpx rgba(200, 165, 91, 0.6), 0 0 80rpx rgba(200, 165, 91, 0.3), 0 0 120rpx rgba(200, 165, 91, 0.12); }
.aura-tu .hero-symbol { text-shadow: 0 0 40rpx rgba(200, 165, 91, 0.55), 0 0 80rpx rgba(200, 165, 91, 0.28), 0 0 120rpx rgba(200, 165, 91, 0.1); }

/* 卦名 + 卦格 */
.hero-gua-info {
  margin-top: 20rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.4s both;
}

.hero-gua-name {
  font-size: 60rpx;
  color: var(--text-primary);
  display: block;
  letter-spacing: 12rpx;
  word-break: break-word;
  font-weight: 500;
}

.hero-gua-ge {
  font-size: 26rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 16rpx;
  letter-spacing: 8rpx;
  word-break: break-word;
  opacity: 0.7;
}

/* ========================================
 * 金线分隔
 * ======================================== */
.divider-gold {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
  margin: 32rpx auto;
  border-radius: 1rpx;
}

.divider-gold.animate-draw-gold-line {
  animation: drawGoldLine 1s var(--ease-out-expo) 0.3s both;
}

@keyframes drawGoldLine {
  0% { width: 0; opacity: 0; }
  100% { width: 120rpx; opacity: 1; }
}

/* ========================================
 * 核心可见区：情绪递进
 * ======================================== */

/* 判词 */
.verdict-section {
  padding: 0 40rpx;
  text-align: center;
  position: relative;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.5s both;
}

/* 判词区左右金线装饰 */
.verdict-section::before,
.verdict-section::after {
  content: '';
  position: absolute;
  top: 20%;
  bottom: 20%;
  width: 2rpx;
  background: linear-gradient(180deg, transparent, var(--accent-gold-border), transparent);
  opacity: 0.4;
}
.verdict-section::before { left: 16rpx; }
.verdict-section::after { right: 16rpx; }

.verdict-text {
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.8;
  letter-spacing: 2rpx;
  word-break: break-word;
}

/* 历史对标金句 */
.quote-section {
  padding: 32rpx 40rpx;
  margin: 16rpx 32rpx;
  text-align: center;
  position: relative;
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.06), rgba(200, 165, 91, 0.02));
  border-radius: 8rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.6s both;
}

/* 大引号装饰 */
.quote-section::before {
  content: '\201C';
  position: absolute;
  top: -10rpx;
  left: 20rpx;
  font-size: 80rpx;
  color: var(--accent-gold);
  opacity: 0.12;
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-text {
  font-size: 30rpx;
  color: var(--gold-pure);
  line-height: 1.8;
  letter-spacing: 2rpx;
  word-break: break-word;
  opacity: 0.9;
}

/* 自嘲标签 */
.tag-section {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 32rpx 24rpx auto;
  padding: 8rpx 20rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.7s both;
}

.tag-text {
  font-size: 24rpx;
  color: var(--gold-pure);
  word-break: break-word;
}

/* ========================================
 * 分享触发点（情绪最高处）
 * ======================================== */
.share-trigger {
  margin: 0 32rpx 32rpx;
  animation: fadeInUp 0.6s var(--ease-out-expo) 0.8s both;
}

.share-trigger-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.15), rgba(200, 165, 91, 0.05));
  border: 2rpx solid transparent;
  background-image: linear-gradient(135deg, rgba(200, 165, 91, 0.15), rgba(200, 165, 91, 0.05)), linear-gradient(135deg, var(--accent-gold-border), rgba(200, 165, 91, 0.3));
  background-origin: border-box;
  background-clip: padding-box, border-box;
  border-radius: 0;
  color: var(--accent-gold);
  font-size: 26rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.share-trigger-btn::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(200, 165, 91, 0.08), transparent 70%);
  animation: breathe 4s var(--ease-in-out) infinite;
  pointer-events: none;
}

@keyframes breathe {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.share-trigger-btn-hover {
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.25), rgba(200, 165, 91, 0.1));
  transform: scale(0.97);
}

.share-trigger-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

/* ========================================
 * 折叠区
 * ======================================== */
.collapse-section {
  margin: 0 32rpx;
}

.collapse-section .collapse-header {
  margin: 0;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.collapse-arrow { transition: transform 0.3s var(--ease-out-expo); }
.collapse-arrow.expanded { transform: rotate(180deg); }

/* 折叠区标题金色序号圆点装饰 */
.collapse-header-title {
  position: relative;
  display: inline-block;
}

.collapse-header-title::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent-gold);
  box-shadow: 0 0 8rpx rgba(200, 165, 91, 0.5);
  margin-right: 12rpx;
  vertical-align: middle;
  position: relative;
  top: -2rpx;
}

.collapse-section .collapse-body-inner {
  padding: 32rpx 0;
}

/* 解读正文 */
.collapse-section .jiedu-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 2;
  letter-spacing: 1rpx;
  word-break: break-word;
  opacity: 0.9;
}

/* ========================================
 * 时空变量（奇门遁甲）
 * ======================================== */
.qimen-group { margin-bottom: 28rpx; }
.qimen-group:last-child { margin-bottom: 0; }

.qimen-group-em {
  padding: 20rpx 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.08) 0%, rgba(200, 165, 91, 0.03) 100%);
  border: 1rpx solid rgba(200, 165, 91, 0.25);
  border-radius: 8rpx;
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.qimen-group-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--gold-pure);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
  font-weight: 500;
}

.qimen-group-dot {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--gold-pure);
  box-shadow: 0 0 8rpx rgba(200, 165, 91, 0.6);
}

.qimen-group-dot-em { background: #C8A55B; }

.qimen-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.qimen-cell {
  padding: 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(200, 165, 91, 0.12);
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.qimen-cell-star,
.qimen-cell-door,
.qimen-cell-shen {
  position: relative;
  padding-left: 22rpx;
}

.qimen-cell-star::before,
.qimen-cell-door::before,
.qimen-cell-shen::before {
  content: '';
  position: absolute;
  left: 0; top: 12rpx; bottom: 12rpx;
  width: 3rpx; border-radius: 2rpx;
}

.qimen-cell-star::before { background: linear-gradient(180deg, #E8C57A, #C8A55B); }
.qimen-cell-door::before { background: linear-gradient(180deg, #C8A55B, #8B7340); }
.qimen-cell-shen::before { background: linear-gradient(180deg, rgba(200,165,91,0.6), rgba(139,115,64,0.3)); }

.qimen-cell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 2rpx;
}

.qimen-cell-label {
  font-size: 20rpx;
  color: var(--gold-pure);
  letter-spacing: 3rpx;
  opacity: 0.85;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.qimen-luck-badge {
  flex-shrink: 0;
}

.qimen-luck-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.qimen-luck-daji, .qimen-luck-ji, .qimen-luck-ciji {
  color: #5A7A3D; border-color: rgba(90, 122, 61, 0.5); background: rgba(90, 122, 61, 0.1);
}
.qimen-luck-xiong, .qimen-luck-daxiong, .qimen-luck-xiaoxiong {
  color: #B0432F; border-color: rgba(176, 67, 47, 0.5); background: rgba(176, 67, 47, 0.1);
}
.qimen-luck-ping, .qimen-luck-zhongping {
  color: #8B7340; border-color: rgba(139, 115, 64, 0.5); background: rgba(139, 115, 64, 0.1);
}

.qimen-cell-value {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.4;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.qimen-cell-sub {
  font-size: 22rpx;
  color: var(--text-faint);
  line-height: 1.5;
  letter-spacing: 1rpx;
  opacity: 0.8;
}

/* 五行生克 */
.qimen-relation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.qimen-relation-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.qimen-relation-label {
  font-size: 20rpx;
  color: var(--gold-pure);
  letter-spacing: 2rpx;
  opacity: 0.8;
  word-break: break-word;
  white-space: nowrap;
}

.qimen-relation-value {
  font-size: 40rpx;
  font-weight: 800;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid;
}

.wuxing-jin { color: #C8A55B; border-color: rgba(200, 165, 91, 0.6); background: rgba(200, 165, 91, 0.1); }
.wuxing-mu { color: #5A7A3D; border-color: rgba(90, 122, 61, 0.6); background: rgba(90, 122, 61, 0.1); }
.wuxing-shui { color: #3A5F8C; border-color: rgba(58, 95, 140, 0.6); background: rgba(58, 95, 140, 0.1); }
.wuxing-huo { color: #B0432F; border-color: rgba(176, 67, 47, 0.6); background: rgba(176, 67, 47, 0.1); }
.wuxing-tu { color: #C8A55B; border-color: rgba(139, 107, 74, 0.6); background: rgba(139, 107, 74, 0.1); }

.qimen-relation-arrow {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.qimen-relation-op {
  font-size: 28rpx;
  color: var(--gold-pure);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.qimen-relation-desc {
  font-size: 20rpx;
  color: var(--text-faint);
  text-align: center;
  line-height: 1.4;
  opacity: 0.8;
}

/* ========================================
 * 宜忌（v19.4.1 版式重构：纵向堆叠整行块）
 * 英文词条较长（≤5 words），左右两栏各 50% 宽时 pill 会换行溢出被截断；
 * 改为宜/忌各占整行，pill 流式 wrap + 可换行，中英文均完整显示
 * ======================================== */
.yiji-grid {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.yi-block, .ji-block { width: 100%; min-width: 0; }

.yi-title, .ji-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

/* 标题后细线延伸：中文"宜/忌"与英文"Do/Don't"均协调 */
.yi-title::after, .ji-title::after {
  content: '';
  flex: 1;
  height: 1rpx;
}

.yi-title { color: var(--gold-pure); }
.yi-title::after { background: linear-gradient(90deg, rgba(200, 165, 91, 0.35), transparent); }
.ji-title { color: var(--text-muted); }
.ji-title::after { background: linear-gradient(90deg, rgba(160, 160, 176, 0.3), transparent); }

.yi-items, .ji-items {
  display: flex;
  flex-direction: column; /* 竖排：每项独占一整行，多长都完整显示不被截断 */
  gap: 14rpx;
}

.yi-item, .ji-item {
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  border-radius: 0;
  letter-spacing: 1rpx;
  width: 100%;
  box-sizing: border-box;
  /* 英文长词条自然换行，不再截断 */
  word-break: break-word;
  white-space: normal;
  text-align: left;
  line-height: 1.5;
}

.yi-item {
  background: rgba(200, 165, 91, 0.08);
  color: var(--gold-pure);
  border: 1rpx solid rgba(200, 165, 91, 0.2);
}

.ji-item {
  background: rgba(232, 232, 240, 0.04);
  color: var(--text-muted);
  border: 1rpx solid rgba(232, 232, 240, 0.08);
}

/* 英文态：字号/字距微调，pill 更紧凑 */
.lang-en .yi-item,
.lang-en .ji-item {
  font-size: 24rpx;
  letter-spacing: 0;
  line-height: 1.4;
  padding: 8rpx 18rpx;
}

.lang-en .yi-title,
.lang-en .ji-title {
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* ========================================
 * 骨架屏
 * ======================================== */
.skeleton-gua-symbol {
  width: 200rpx; height: 200rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(200, 165, 91, 0.08), rgba(200, 165, 91, 0.02));
  border: 1rpx dashed rgba(200, 165, 91, 0.2);
  animation: skeletonPulse 2s ease-in-out infinite;
}

.skeleton-gua-name {
  width: 240rpx; height: 48rpx;
  margin: 0 auto 16rpx;
  background: linear-gradient(90deg, rgba(200, 165, 91, 0.08), rgba(200, 165, 91, 0.02));
  animation: skeletonPulse 2s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  margin: 16rpx auto;
  background: linear-gradient(90deg, rgba(232, 232, 240, 0.06), rgba(232, 232, 240, 0.02));
  animation: skeletonPulse 2s ease-in-out infinite;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

/* ========================================
 * 底部操作栏
 * ======================================== */
.bottom-actions {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(10, 10, 26, 0.98), rgba(10, 10, 26, 0.9));
  backdrop-filter: blur(20rpx);
  z-index: 10;
  border-top: 1rpx solid rgba(200, 165, 91, 0.3);
}

.bottom-actions button {
  flex: 1; min-width: 0;
  height: 96rpx;
  border-radius: 0;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
  transition: all 0.2s var(--ease-out-expo);
}

.bottom-actions .btn-light {
  background: transparent;
  border: 2rpx solid var(--accent-gold-border);
  color: var(--accent-gold);
}

.bottom-actions .btn-light:active {
  background: var(--accent-gold-subtle);
  transform: scale(0.97);
}

.bottom-actions .btn-gold {
  background: var(--gold-pure);
  color: var(--text-inverse);
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(200, 165, 91, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.bottom-actions .btn-gold:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(200, 165, 91, 0.4);
}

/* ===== EN-i18n layout fix ===== */
.lang-en .qimen-luck-badge { letter-spacing: 0; padding: 2rpx 10rpx; font-size: 20rpx; }
.lang-en .qimen-cell-label { font-size: 18rpx; letter-spacing: 0; }
.lang-en .qimen-relation-label { font-size: 18rpx; letter-spacing: 0; white-space: nowrap; }
.lang-en .share-trigger-text { font-size: 24rpx; letter-spacing: 0; }

/* ===== EN-i18n title fix ===== */
.lang-en .hero-gua-name { letter-spacing: 2rpx; text-indent: 2rpx; font-size: 38rpx; line-height: 1.25; }

/* ===== EN-i18n label fix ===== */
.lang-en .hero-title-text { letter-spacing: 2rpx; text-indent: 2rpx; line-height: 1.3; }
.lang-en .hero-gua-ge { letter-spacing: 2rpx; text-indent: 2rpx; line-height: 1.3; }
