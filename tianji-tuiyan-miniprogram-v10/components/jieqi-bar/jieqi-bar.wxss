}

.lang-en .recipe-effect {
  font-size: 18rpx;
  flex-shrink: 1;
  text-align: right;
  max-width: 320rpx;
  line-height: 1.35;
}

/* 物候日记标签：Smooth Qi / Even Qi / Stuck Qi */
