/* ==================== v19.2 英文适配（lang-en，WXML 根节点注入） ==================== */
/* 原则：保持原 UI 元素大小，通过字号/排版微调适配英文长度 */

/* 拉杆节气名：竖排 → 横排小字换行（英文竖排不可读） */
.lang-en .tab-name {
  writing-mode: horizontal-tb;
  text-orientation: mixed;
  font-size: 15rpx;
  letter-spacing: 0.01em;
  line-height: 1.25;
  text-align: center;
  max-width: 60rpx;
  word-break: break-word;
}

/* 拉杆"养生/秘典"：Wellness / Guide */
.lang-en .tab-day {
  font-size: 16rpx;
  letter-spacing: 0.02em;
}

/* 详情主标题：Autumnal Equinox 等长名缩号居中 */
.lang-en .hero-name {
  font-size: 46rpx;
  letter-spacing: 0.04em;
  text-align: center;
  line-height: 1.2;
  max-width: 640rpx;
}

.lang-en .hero-date {
  font-size: 21rpx;
  letter-spacing: 0.03em;
}

.lang-en .hero-tag {
  font-size: 19rpx;
  padding: 8rpx 20rpx;
  letter-spacing: 0.02em;
}

/* 物候三候：英文候名较长，缩号防挤爆列宽 */
.lang-en .node-label {
  font-size: 17rpx;
  letter-spacing: 0.03em;
}

.lang-en .node-text {
  font-size: 20rpx;
  max-width: 190rpx;
  letter-spacing: 0.01em;
}

/* 关键词标签 */
.lang-en .keyword-item {
  font-size: 19rpx;
  letter-spacing: 0.03em;
  padding: 6rpx 16rpx;
}

/* 食材/行动宫格名：Shepherd's Purse 等长名缩号 */
.lang-en .cell-name {
  font-size: 18rpx;
  max-width: 172rpx;
  letter-spacing: 0.01em;
}

/* 五行关系图：dot 内英文五行名 + 两侧卦格名 + 关系标题 */
.lang-en .dot-char {
  font-size: 19rpx;
}

.lang-en .relation-label {
  font-size: 17rpx;
  letter-spacing: 0.02em;
}

.lang-en .tag-text {
  font-size: 18rpx;
  letter-spacing: 0.02em;
}

/* 推荐菜：菜名 + 功效英文较长，允许收缩换行 */
.lang-en .recipe-name {
  font-size: 25rpx;
