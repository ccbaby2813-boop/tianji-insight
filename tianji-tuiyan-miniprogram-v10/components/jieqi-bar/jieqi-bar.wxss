  font-size: 24rpx;
}

.lang-en .tag-label {
  font-size: 17rpx;
  letter-spacing: 0.02em;
}

/* 底部按钮 */
.lang-en .btn-text {
  font-size: 26rpx;
  letter-spacing: 0.04em;
}

